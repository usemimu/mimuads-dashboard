# Mimuads Console — environment. Copy to .env (local) / set in CI per environment.
# The app FAILS LOUDLY if VITE_APP_ENV is missing or not one of: dev | staging | production.

VITE_APP_ENV=dev
# Backend API origin including the /v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/v1
# Google Maps JS API key. Optional in dev/CI (map shows a fallback); set in staging/prod.
VITE_GOOGLE_MAPS_API_KEY=
# Paystack publishable key (NOT a secret; test key in non-prod).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

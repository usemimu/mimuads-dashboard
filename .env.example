# Mimuads Console — environment. Copy to .env (local) / set in CI per environment.
# The app FAILS LOUDLY if VITE_APP_ENV is missing or not one of: dev | staging | production.

VITE_APP_ENV=dev
# Backend API origin including the /v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/v1
# Google Maps JS API key. Optional in dev/CI (map shows a fallback); set in staging/prod.
VITE_GOOGLE_MAPS_API_KEY=
# Paystack publishable key (NOT a secret; test key in non-prod).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Google OAuth 2.0 web client ID for Sign in with Google (GIS).
# Get it from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Web client.
# Also add ads.usemimu.com as an Authorized JavaScript origin on that client.
# OPTIONAL — Google button is hidden when unset.
VITE_GOOGLE_AUTH_CLIENT_ID=
# Apple Services ID for Sign in with Apple on web.
# Register one at: developer.apple.com → Certificates, Identifiers & Profiles → Identifiers → Services IDs.
# OPTIONAL — Apple button is hidden when unset.
VITE_APPLE_CLIENT_ID=
